{
  "type": "object",
  "required": ["sender_id", "game_id", "original_text", "corrected_text", "timestamp"],
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "Unique identifier of the message sender"
    },
    "sender_role": {
      "type": "string",
      "enum": ["player", "system", "ai", "teacher"],
      "description": "Role of the sender"
    },
    "recipient_id": {
      "type": "string",
      "description": "Unique identifier of the recipient (optional if channel is set)"
    },
    "channel": {
      "type": "string",
      "enum": ["global", "team", "private"],
      "description": "Message channel type"
    },
    "game_id": {
      "type": "string",
      "description": "Identifier of the game (e.g., 'word-runner', 'hangman', 'word-duel')"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier for tracking context"
    },
    "original_text": {
      "type": "string",
      "description": "The raw user-submitted message text"
    },
    "corrected_text": {
      "type": "string",
      "description": "The AI-corrected message text"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of tags (see tags-reference.json for full list)"
    },
    "audience": {
      "type": "string",
      "enum": ["child", "teacher", "mixed"],
      "description": "Target audience for the message"
    },
    "locale": {
      "type": "string",
      "description": "Language/locale code (e.g., 'en-US', 'es-ES')"
    },
    "style": {
      "type": "string",
      "enum": ["friendly", "encouraging", "neutral", "instructional"],
      "description": "Tone/style of the message"
    },
    "ai_model": {
      "type": "string",
      "description": "Model used for corrections (e.g., 'llama-3.3-70b-versatile')"
    },
    "ai_response_meta": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score of AI corrections"
        },
        "applied_changes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of change categories applied (e.g., ['spelling', 'punctuation'])"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "sent", "flagged", "blocked", "delivered"],
      "description": "Message delivery status"
    },
    "preserve_tokens": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Special tokens to preserve in correction"
    }
  }
}
